@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="auth-wrap"><div class="auth-card">
  <div class="auth-logo">₹</div><h1 class="page-title text-center">Create your account</h1><p class="text-secondary text-center mb-4">Start tracking every rupee.</p>
  <form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" placeholder="Your full name"/><span asp-validation-for="FullName" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger small"></span><div class="form-text">Use at least 8 characters with an uppercase letter and a number.</div></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
    <button type="submit" class="btn btn-primary w-100">Create account</button>
  </form>
  <p class="text-center mt-4 mb-0 small">Already registered? <a asp-action="Login">Login</a></p>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
