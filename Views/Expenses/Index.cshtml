@model IEnumerable<Expense>
@{
    ViewData["Title"] = "Expenses";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3"><div><p class="eyebrow mb-1">TRANSACTION HISTORY</p><h1 class="page-title mb-0">Expenses</h1></div><a class="btn btn-primary" asp-action="Create">＋ Add expense</a></div>
<div class="panel-card mb-3">
<form method="get" asp-action="Index" class="row g-3 align-items-end">
  <div class="col-12 col-md-3"><label class="form-label">Search title</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="e.g. Lunch"/></div>
  <div class="col-12 col-md-2"><label class="form-label">Category</label><select class="form-select" name="category"><option value="">All categories</option>@foreach (string c in ViewBag.Categories) { <option value="@c" selected="@(ViewBag.Category as string == c)">@c</option> }</select></div>
  <div class="col-6 col-md-2"><label class="form-label">From</label><input type="date" class="form-control" name="fromDate" value="@ViewBag.FromDate"/></div>
  <div class="col-6 col-md-2"><label class="form-label">To</label><input type="date" class="form-control" name="toDate" value="@ViewBag.ToDate"/></div>
  <div class="col-12 col-md-2"><label class="form-label">Sort by</label><select class="form-select" name="sort"><option value="date" selected="@(ViewBag.Sort as string != "amount")">Latest date</option><option value="amount" selected="@(ViewBag.Sort as string == "amount")">Highest amount</option></select></div>
  <div class="col-12 col-md-1 d-grid"><button class="btn btn-dark" type="submit">Go</button></div>
</form>
</div>
<div class="panel-card">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><h2 class="section-title mb-0">Transaction list</h2><div class="text-secondary small">Filtered total: <strong>@(((decimal)ViewBag.FilteredTotal).ToString("C", new System.Globalization.CultureInfo("en-IN")))</strong></div></div>
  @if (!Model.Any()) { <div class="empty-state"><h3>No matching expenses</h3><p>Try changing the filters or add an expense.</p></div> }
  else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Title</th><th>Category</th><th>Date</th><th>Payment</th><th class="text-end">Amount</th><th class="text-end">Actions</th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td><div class="fw-semibold">@item.Title</div><div class="text-secondary small">@item.Description</div></td><td><span class="category-pill">@item.Category</span></td><td>@item.ExpenseDate.ToString("dd MMM yyyy")</td><td>@item.PaymentMethod</td><td class="text-end fw-bold">@item.Amount.ToString("C", new System.Globalization.CultureInfo("en-IN"))</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
  </tbody></table></div> }
</div>
